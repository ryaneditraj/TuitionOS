# Copy to .env. Generate a signing key with: openssl rand -base64 48
# Do not reuse trinity-one-super-secret-key-2026-tei. That value was committed
# and is rejected by the app.
JWT_SECRET=

# Sample persona switcher and automatic student session.
# Set to false before any real student data.
DEMO_MODE=true

# Password hashed into the local database the first time it is created.
# The default below is a public sample password. Change it, then delete trinity.db, before a real deployment.
DEMO_PASSWORD=trinity123

# Public origin used for canonical URLs, Open Graph, sitemap, and robots.
# No trailing slash. Set this at build time for a deployed site.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
